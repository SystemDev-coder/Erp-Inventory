NODE_ENV=production
PORT=5000
HOST=127.0.0.1

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=erp_inventory
PGUSER=ims_app
PGPASSWORD=replace-with-app-db-password
PGSCHEMA=ims
APP_RUNTIME_ROLE=ims_runtime

ADMIN_PGUSER=postgres
ADMIN_PGPASSWORD=replace-with-postgres-admin-password

AUTO_RESET_ON_SCHEMA_MISMATCH=false
RUN_DEMO_SEED=false
ALLOW_NEGATIVE_STOCK=false

CLIENT_ORIGIN=http://YOUR_SERVER_IP_OR_DOMAIN

JWT_ACCESS_SECRET=replace-with-32-plus-random-chars-access
JWT_REFRESH_SECRET=replace-with-32-plus-random-chars-refresh
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

COOKIE_NAME=rt
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

RESET_CODE_EXPIRES_MIN=10
DEV_RETURN_RESET_CODE=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UNSIGNED_PRESET=
