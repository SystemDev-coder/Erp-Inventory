[Unit]
Description=ERP Inventory database bootstrap and migrations
Wants=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=erp
Group=erp
WorkingDirectory=/srv/pms-bench/backend
EnvironmentFile=/srv/pms-bench/backend/.env
Environment=NODE_ENV=production
Environment=MIGRATIONS_DIR=/srv/pms-bench/backend/sql
ExecStart=/bin/sh /srv/pms-bench/backend/docker/entrypoint.sh /bin/true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

