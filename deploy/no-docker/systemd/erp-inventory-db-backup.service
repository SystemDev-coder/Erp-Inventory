[Unit]
Description=ERP Inventory PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=erp
Group=erp
EnvironmentFile=/srv/pms-bench/backend/.env
ExecStart=/bin/sh -c 'mkdir -p /srv/pms-bench/backups && PGPASSWORD="$ADMIN_PGPASSWORD" pg_dump -h "$PGHOST" -p "$PGPORT" -U "$ADMIN_PGUSER" -Fc -d "$PGDATABASE" -f "/srv/pms-bench/backups/${PGDATABASE}-$(date +%%F-%%H%%M%%S).dump"'

