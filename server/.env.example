# Database Configuration
PGHOST=db
PGPORT=5432
PGUSER=postgres
PGPASSWORD=123
PGDATABASE=erp_inventory
PGSCHEMA=ims
APP_RUNTIME_ROLE=ims_runtime

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (Required for Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: prefixes every uploaded image's folder with this value, e.g.
# "erp-inventory/<prefix>/products/..." - used to keep one shared Cloudinary
# account organized when hosting multiple clients (see MULTI_CLIENT.md).
CLOUDINARY_FOLDER_PREFIX=

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=3

# CORS Configuration
FRONTEND_URL=http://localhost:5173
